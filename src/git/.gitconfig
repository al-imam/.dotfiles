[user]
	email = alimam01828@gmail.com
	name = al-imam

[core]
	editor = code --wait
	eol = lf
	autocrlf = false
	whitespace = cr-at-eol
	symlinks = true
	excludesfile = ~/.gitignore_global
	longpaths = true

[init]
	defaultBranch = main

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	required = true
	process = git-lfs filter-process

[push]
	autoSetupRemote = true

[alias]
	lp = log --color --graph --pretty=format:'%Cred%h%Creset %C(bold blue)<%an>%Creset %s %Cgreen(%cr) %C(yellow)%d%Creset' --abbrev-commit
	ll = log-short --stat
	s = status -sb
	b = branch
	a = add
	aa = add --all

[safe]
	directory = *

[checkout]
	defaultRemote = origin

[credential "https://github.com"]
    helper =
    helper = !~/scoop/apps/gh/current/bin/gh.exe auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !~/scoop/apps/gh/current/bin/gh.exe auth git-credential
